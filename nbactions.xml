<?xml version="1.0" encoding="UTF-8"?>
<!-- Hành động Run/Debug của NetBeans: chạy ứng dụng bằng exec:java (xem pom.xml) -->
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.5.0:java</goal>
        </goals>
    </action>
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.5.0:java</goal>
        </goals>
        <properties>
            <jpda.listen>true</jpda.listen>
            <Env.MAVEN_OPTS>-agentlib:jdwp=transport=dt_socket,server=n,address=${jpda.address}</Env.MAVEN_OPTS>
        </properties>
    </action>
</actions>
