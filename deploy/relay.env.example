# Mẫu cấu hình relay. Sao chép thành relay.env rồi sửa. KHÔNG commit relay.env (đã có trong .gitignore).

# Tên miền trỏ về IP của VPS (Caddy dùng để xin chứng chỉ TLS)
RELAY_DOMAIN=relay.example.com

# Khoá HMAC ký link token (>= 32 ký tự), để liên kết giữa các peer còn hiệu lực sau khi relay khởi động lại.
# Tạo ngẫu nhiên:  openssl rand -hex 32
RELAY_LINK_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu

# Mã mời: thời hạn (giây) và số lần dùng
RELAY_INVITE_TTL_SECONDS=600
RELAY_INVITE_MAX_USES=1

# Heartbeat: relay ping mỗi HEARTBEAT giây, không nhận được gì trong IDLE_TIMEOUT giây thì coi máy đã mất mạng
RELAY_HEARTBEAT_SECONDS=15
RELAY_IDLE_TIMEOUT_SECONDS=45

# Giới hạn tài nguyên
RELAY_MAX_SESSIONS=500
RELAY_MAX_CONN_PER_IP=20
RELAY_MAX_STREAMS_PER_SESSION=64
# Byte tối đa đang chờ gửi tới 1 máy (backpressure): 4 MiB
RELAY_SESSION_QUEUE_BYTES=4194304
RELAY_STALL_TIMEOUT_SECONDS=20

# Số lần nhập sai mã mời tối đa: theo phiên (trong 60s) và theo IP (trong 600s)
RELAY_RESOLVE_MAX_FAILS=5
RELAY_RESOLVE_MAX_FAILS_PER_IP=20

# Chỉ dùng khi chạy relay KHÔNG qua Caddy/Nginx mà tự bật TLS (file PKCS12 + mật khẩu)
# RELAY_TLS_KEYSTORE=/certs/relay.p12
# RELAY_TLS_KEYSTORE_PASSWORD=
