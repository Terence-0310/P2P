<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.p2pfileshare.controller.SearchTabController"
            style="-fx-background-color: #f8f9fa;">

    <VBox spacing="15" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">

        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);">
            <children>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="🔍" style="-fx-font-size: 20px;" />
                    <VBox HBox.hgrow="ALWAYS" spacing="5">
                        <Label text="Từ khóa" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-font-size: 11px;" />
                        <TextField fx:id="searchField" promptText="Nhập tên file cần tìm..." style="-fx-background-radius: 5;" />
                    </VBox>
                    <Button text="Tìm kiếm" onAction="#onSearch" defaultButton="true" styleClass="button" prefHeight="35" minWidth="100" />
                </HBox>

                <Separator />

                <HBox spacing="20" alignment="CENTER_LEFT">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Lọc môn:" style="-fx-text-fill: #2c3e50;" />
                        <TextField fx:id="filterSubjectField" promptText="VD: Java" prefWidth="180" style="-fx-background-radius: 5;" />
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Lọc Peer:" style="-fx-text-fill: #2c3e50;" />
                        <TextField fx:id="filterPeerField" promptText="VD: May-A" prefWidth="180" style="-fx-background-radius: 5;" />
                    </HBox>
                </HBox>
            </children>
        </VBox>

        <VBox VBox.vgrow="ALWAYS">
            <TableView fx:id="searchResultTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colName" text="Tên file" prefWidth="300" />
                    <TableColumn fx:id="colSubject" text="Môn học" prefWidth="120" style="-fx-alignment: CENTER;" />
                    <TableColumn fx:id="colSize" text="Kích thước" prefWidth="100" style="-fx-alignment: CENTER;" />
                    <TableColumn fx:id="colOwner" text="Chủ sở hữu" prefWidth="150" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <placeholder>
                    <Label text="Nhập từ khóa và bấm Tìm kiếm để bắt đầu" style="-fx-text-fill: #bdc3c7; -fx-font-size: 14px;" />
                </placeholder>
            </TableView>
        </VBox>

        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);">

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Tiến trình:" style="-fx-font-weight: bold; -fx-text-fill: #95a5a6; -fx-font-size: 11px;" />
                <ProgressBar fx:id="downloadProgress" prefWidth="400" progress="0.0" HBox.hgrow="ALWAYS" style="-fx-accent: #2ecc71;" />
                <Label fx:id="downloadStatusLabel" text="Sẵn sàng" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic; -fx-font-size: 11px;" minWidth="100" alignment="CENTER_RIGHT"/>
            </HBox>

            <Separator />

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnDownload" text="⬇ Tải xuống" onAction="#onDownloadSelected"
                        styleClass="button" style="-fx-background-color: #3498db; -fx-font-weight: bold;" />

                <Button text="👁 Xem chi tiết" onAction="#onViewFileDetails" styleClass="button, secondary" />

                <Region HBox.hgrow="ALWAYS" /> <Button fx:id="btnPause" text="⏸ Tạm dừng" onAction="#onPauseDownload" disable="true"
                                                       styleClass="button, secondary" />

                <Button fx:id="btnResume" text="▶ Tiếp tục" onAction="#onResumeDownload" disable="true"
                        styleClass="button" style="-fx-background-color: #27ae60;" />

                <Button fx:id="btnCancel" text="⏹ Hủy bỏ" onAction="#onCancelDownload" disable="true"
                        styleClass="button, danger" />
            </HBox>
        </VBox>



    </VBox>
</AnchorPane>